---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getVisiblePosts } from '../../lib/content';
import { LANGS, type Lang } from '../../lib/posts';
import { listPath } from '../../lib/seo';
import { ui } from '../../i18n/ui';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const posts = (await getVisiblePosts()).filter((p) => p.id.endsWith(`/${lang}`));
const desc = lang === 'en'
  ? 'Guides and comparisons on online payments, DuitNow and collections for Malaysian businesses.'
  : 'Panduan dan perbandingan tentang bayaran dalam talian, DuitNow dan kutipan untuk perniagaan Malaysia.';
---
<BaseLayout title={`${t.blogName} — ${t.latest}`} description={desc} lang={lang} canonicalPath={listPath(lang)}>
  <h1>{t.latest}</h1>
  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>
