{
  "name": "aruspay-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-headers.mjs",
    "build:staging": "BLOG_ENV=staging npm run build && npm run check:build",
    "build:production": "BLOG_ENV=production npm run build && npm run check:build",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm test && npm run build:production && npm run build:staging",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/urbanist": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "satteri": "^0.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
